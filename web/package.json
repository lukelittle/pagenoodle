{
  "name": "pagenoodle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "engine": "make -C ../engine wasm",
    "vendor": "node scripts/vendor.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.1.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
